# Postgres (Supabase: Project Settings > Database > Connection string)
# DATABASE_URL usa o pooler (porta 6543) e DIRECT_URL a conexão direta (porta 5432).
DATABASE_URL="postgresql://postgres:senha@localhost:5432/eventos"
DIRECT_URL="postgresql://postgres:senha@localhost:5432/eventos"
# Segredo para assinar a sessão de login. Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo"
